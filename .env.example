# DeepSeek API key used by the AI agent (required).
# Get one at https://platform.deepseek.com/ and keep it private.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Password-less demo login. Enabled by default so the app works
# out of the box. Set to 0 to disable it in production.
ENABLE_DEMO_LOGIN=1

# Chat requests allowed per session per minute. Chat is the only
# endpoint that spends money, so it is limited. Set to 0 to disable.
CHAT_RATE_LIMIT_PER_MINUTE=20

# Optional: use a different SQLite file (tests, or a mounted volume).
# Defaults to database/library.db inside the project.
# LIBRARY_DB_PATH=/data/library.db

# Optional: per-turn tracing. Each line is one JSON record: LLM calls
# with token counts and latency, tool calls with their arguments and
# outcome, and one summary per turn. Same records go to the
# "library_agent.trace" logger.
# AGENT_TRACE_PATH=database/agent-trace.jsonl

# Optional: use a real embedding model for semantic search instead of the
# built-in local vectors. Any OpenAI-compatible endpoint works.
# EMBEDDING_API_KEY=your_embedding_api_key_here
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# Due-date reminder delivery. Only scripts/due_reminders.py reads these,
# and only when it is called with --email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=library@example.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=library@example.com
# SMTP_TLS=1
